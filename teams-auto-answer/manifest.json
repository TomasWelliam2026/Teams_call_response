{
  "manifest_version": 3,
  "name": "Teams Call Answerer",
  "version": "0.5.1",
  "description": "Answer Microsoft Teams (web) calls with shortcuts or auto-answer, and bridge answered calls' audio to your server.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "tabs", "sidePanel", "alarms"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["page-audio.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["detector.js", "bridge.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Teams Call Answerer",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "accept-audio": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "Command+Shift+1" },
      "description": "Accept incoming call (audio)",
      "global": true
    },
    "accept-video": {
      "suggested_key": { "default": "Ctrl+Shift+2", "mac": "Command+Shift+2" },
      "description": "Accept incoming call (video)",
      "global": true
    },
    "decline": {
      "suggested_key": { "default": "Ctrl+Shift+3", "mac": "Command+Shift+3" },
      "description": "Decline incoming call",
      "global": true
    },
    "toggle-auto-answer": {
      "suggested_key": { "default": "Ctrl+Shift+4", "mac": "Command+Shift+4" },
      "description": "Turn auto-answer on/off",
      "global": true
    }
  }
}
