{
  "manifest_version": 3,
  "name": "Teams Call Answerer",
  "version": "0.6.0",
  "description": "Links Teams web to your Call Bridge server, so calls ring, are answered and are talked on from the Call Bridge app.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "sidePanel", "alarms"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["page-audio.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["detector.js", "bridge.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Teams Call Answerer: server connection"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
